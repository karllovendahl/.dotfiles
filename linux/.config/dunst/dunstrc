# Generated by palette-apply from ink-paper.sh. Do not edit.
[global]
    monitor = 0
    follow = keyboard
    width = (360, 420)
    height = (0, 120)
    origin = top-right
    offset = (8, 6)
    notification_limit = 4
    indicate_hidden = yes
    gap_size = 8
    transparency = 0
    separator_height = 1
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#26344f"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Hack Nerd Font Mono 10
    line_height = 2
    markup = full
    format = "<span foreground='#a84a2b'><b>[%a]</b></span>\n<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita, hicolor
    min_icon_size = 32
    max_icon_size = 40
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu
    browser = /usr/bin/xdg-open
    corner_radius = 0
    icon_corner_radius = 0
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    enable_posix_regex = true

[urgency_low]
    background = "#f8f8f7"
    foreground = "#667085"
    frame_color = "#667085"
    timeout = 4

[urgency_normal]
    background = "#f8f8f7"
    foreground = "#162033"
    frame_color = "#26344f"
    timeout = 6

[urgency_critical]
    background = "#f8f8f7"
    foreground = "#162033"
    frame_color = "#aa3731"
    timeout = 0
