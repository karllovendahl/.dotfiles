@import "current-colors.rasi"

* {
    spacing: 0;
}

window {
    width: 644px;
    padding: 20px;
    border: 2px;
    border-radius: 12px;
    border-color: @border-color;
    background-color: @base;
}

mainbox {
    spacing: 10px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 10px;
    border-radius: 8px;
    background-color: @surface;
    children: [ entry ];
}

entry {
    placeholder: "Search applications";
    placeholder-color: @muted;
    text-color: @text;
}

listview {
    lines: 5;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 14px;
    spacing: 14px;
    background-color: transparent;
    text-color: @text;
    cursor: pointer;
    children: [ element-text ];
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: transparent;
    text-color: @selected;
}
