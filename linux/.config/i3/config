# Personal i3 configuration, tracked in ~/.dotfiles.
# i3 is the window manager; supporting desktop services are started below.

set $mod Mod4
font pango:Hack Nerd Font Mono 10
include ~/.config/i3/theme.conf

# Apply display layout once at login, then react to kernel DRM hotplug events.
exec --no-startup-id $HOME/.local/bin/i3-display-watch
exec_always --no-startup-id $HOME/.local/bin/i3-wallpaper-restore

# Keep the keyboard aligned with the GNOME setup: repeat after 140 ms at 40 Hz.
exec_always --no-startup-id xset r rate 140 40

# Start ordinary XDG desktop services, locking, and network controls.
exec --no-startup-id dex-autostart --autostart --environment i3
exec --no-startup-id picom --config $HOME/.config/picom/picom.conf
exec --no-startup-id xss-lock --transfer-sleep-lock -- $HOME/.local/bin/i3-lock-safe
exec --no-startup-id nm-applet

floating_modifier $mod
focus_follows_mouse no

# Keep windows clean: no title bars, just a thin border and modest tiling gaps.
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 4
smart_gaps off

# Applications and session controls. Power actions live in the Super+Space launcher.
bindsym $mod+Return exec --no-startup-id wezterm
bindsym $mod+space exec --no-startup-id $HOME/.local/bin/rofi-launcher
bindsym $mod+Escape exec --no-startup-id $HOME/.local/bin/i3-lock-safe
bindsym $mod+p exec --no-startup-id arandr
bindsym XF86Display exec --no-startup-id arandr
bindsym $mod+Shift+s exec --no-startup-id $HOME/.local/bin/i3-screenshot
bindsym $mod+w kill

# Focus and move windows with Vim directions.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Arrow-key equivalents.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout controls.
bindsym $mod+t floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+e layout toggle split
bindsym $mod+a focus parent

# Numbered workspaces are created on demand.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Keep workspaces 1–4 on the primary output: the external display while
# docked, otherwise the laptop panel.
workspace $ws1 output primary
workspace $ws2 output primary
workspace $ws3 output primary
workspace $ws4 output primary

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move the focused window and follow it to the destination workspace.
bindsym $mod+Shift+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9; workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10; workspace number $ws10

# Resize mode uses the same directional keys.
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Reload configuration or restart i3 without ending the session.
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Hardware controls.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id $HOME/.local/bin/i3-osd volume-up; exec --no-startup-id $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id $HOME/.local/bin/i3-osd volume-down; exec --no-startup-id $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id $HOME/.local/bin/i3-osd volume-toggle; exec --no-startup-id $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86MonBrightnessUp exec --no-startup-id $HOME/.local/bin/i3-osd brightness-up
bindsym XF86MonBrightnessDown exec --no-startup-id $HOME/.local/bin/i3-osd brightness-down

# ThinkPad star key media cluster.
bindsym XF86Favorites exec --no-startup-id playerctl play-pause
bindsym Shift+XF86Favorites exec --no-startup-id playerctl next
bindsym Mod1+Shift+XF86Favorites exec --no-startup-id playerctl previous

# Use Polybar when installed; otherwise fall back to the stock i3bar.
bar {
    i3bar_command $HOME/.local/bin/i3bar-polybar-fallback
    status_command i3status
}
