#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

notify_level() {
	local tag="$1" icon="$2" label="$3" percent="$4"
	dunstify \
		--app-name="System" \
		--urgency=low \
		--transient \
		--expire-time=1200 \
		--stack-tag="$tag" \
		--icon="$icon" \
		--hint="int:value:${percent}" \
		"$label" "${percent}%"
}

case "${1:-}" in
volume-status)
	volume_state="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
	if [[ -z "$volume_state" ]]; then
		printf '󰝟 unavailable\n'
	elif [[ "$volume_state" == *MUTED* ]]; then
		printf '󰝟 muted\n'
	else
		awk '{ printf "󰕾 %d%%\n", $2 * 100 + 0.5 }' <<<"$volume_state"
	fi
	exit 0
	;;
volume-up)
	wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
	wpctl set-volume --limit 1 @DEFAULT_AUDIO_SINK@ 5%+
	;;
volume-down)
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
	;;
volume-toggle)
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
	;;
brightness-up)
	brightnessctl --quiet set 5%+
	;;
brightness-down)
	brightnessctl --quiet set 5%-
	;;
*)
	echo "Usage: i3-osd volume-status|volume-up|volume-down|volume-toggle|brightness-up|brightness-down" >&2
	exit 2
	;;
esac

case "$1" in
volume-*)
	volume_state="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
	volume_percent="$(awk '{printf "%d", $2 * 100 + 0.5}' <<<"$volume_state")"
	if [[ "$volume_state" == *MUTED* ]]; then
		notify_level volume audio-volume-muted-symbolic "Muted" "$volume_percent"
	else
		notify_level volume audio-volume-high-symbolic "Volume" "$volume_percent"
	fi
	;;
brightness-*)
	brightness_percent="$(brightnessctl -m | awk -F, '{gsub(/%/, "", $4); print $4}')"
	notify_level brightness display-brightness-symbolic "Brightness" "$brightness_percent"
	;;
esac
