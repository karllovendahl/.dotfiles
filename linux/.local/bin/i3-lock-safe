#!/usr/bin/env bash

set -euo pipefail

lockfile="${XDG_RUNTIME_DIR:-/tmp}/i3-lock-safe.lock"
exec 8>"$lockfile"

lock_active() {
	pgrep -xu "$EUID" i3lock >/dev/null 2>&1
}

sleep_lock_active() {
	[[ -n "${XSS_SLEEP_LOCK_FD:-}" && -e "/dev/fd/${XSS_SLEEP_LOCK_FD}" ]]
}

release_sleep_lock() {
	if sleep_lock_active; then
		exec {XSS_SLEEP_LOCK_FD}<&-
	fi
}

wait_for_existing_lock() {
	# A competing wrapper may still be starting i3lock. Keep logind's sleep
	# inhibitor until the lock is visibly active. If that wrapper fails first,
	# acquire its lock and let this process establish the screen lock instead.
	while ! lock_active; do
		if flock --nonblock 8; then
			return 1
		fi
		sleep 0.05
	done

	release_sleep_lock
	while lock_active; do
		sleep 0.5
	done
	return 0
}

# Make locking idempotent. Multiple key events, xss-lock triggers, or lid/sleep
# races should not spawn competing i3lock instances that fight for input.
if ! flock --nonblock 8; then
	if wait_for_existing_lock; then
		exit 0
	fi
fi

if grep -Eq '^[[:space:]]*auth.*pam_fprintd\.so' /etc/pam.d/system-auth; then
	dunstify --urgency=critical --expire-time=8000 --stack-tag=i3lock \
		"Lock screen unavailable" \
		"Disable Authselect's with-fingerprint feature before using i3lock."
	if sleep_lock_active; then
		# Fail closed: keep logind's inhibitor open rather than suspending without
		# a lock screen when authentication configuration has drifted.
		while true; do sleep 3600; done
	fi
	exit 1
fi

if lock_active; then
	wait_for_existing_lock
	exit 0
fi

lock_args=()
lock_background="$HOME/.cache/i3/lock-background.png"
if [[ -r "$lock_background" ]]; then
	lock_args=(-i "$lock_background")
fi

# xss-lock passes XSS_SLEEP_LOCK_FD when logind is preparing to sleep. Use
# i3lock's daemon mode and release the inhibitor only after i3lock has acquired
# the screen. If startup fails, keep the inhibitor open and fail closed.
if sleep_lock_active; then
	kill_i3lock() {
		pkill -xu "$EUID" "$@" i3lock
	}

	trap kill_i3lock TERM INT

	if ! i3lock "${lock_args[@]}" {XSS_SLEEP_LOCK_FD}<&-; then
		while true; do sleep 3600; done
	fi
	while ! lock_active; do
		sleep 0.05
	done
	release_sleep_lock

	while kill_i3lock -0; do
		sleep 0.5
	done
else
	exec i3lock --nofork "${lock_args[@]}"
fi
