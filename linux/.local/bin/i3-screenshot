#!/usr/bin/env bash

set -euo pipefail

out_dir="$HOME/Pictures/Screenshots"
mkdir -p "$out_dir"
out_file="$out_dir/screenshot-$(date +%Y%m%d-%H%M%S).png"

maim --select "$out_file"
xclip -selection clipboard -target image/png -i "$out_file"

if command -v dunstify >/dev/null 2>&1; then
	dunstify --expire-time=2500 --stack-tag=screenshot \
		"Screenshot" \
		"Copied to clipboard and saved to ${out_file#"$HOME"/}"
fi
