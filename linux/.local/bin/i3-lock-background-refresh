#!/usr/bin/env bash

set -euo pipefail

if ! command -v magick >/dev/null 2>&1; then
	exit 0
fi

wallpaper=""
if [[ -r "$HOME/.fehbg" ]]; then
	wallpaper="$(awk -F"'" '/feh / { print $2; exit }' "$HOME/.fehbg")"
fi

if [[ -z "$wallpaper" || ! -r "$wallpaper" ]]; then
	exit 0
fi

dimensions="$(xrandr --query | awk '/^Screen 0:/ { gsub(/,/, "", $8); gsub(/,/, "", $10); print $8 " " $10; exit }')"
read -r width height <<<"$dimensions"
[[ -n "${width:-}" && -n "${height:-}" ]] || exit 0

out_file="$HOME/.cache/i3/lock-background.png"
tmp_file="${out_file}.tmp.png"
mkdir -p "$(dirname -- "$out_file")"

magick "$wallpaper" \
	-auto-orient \
	-resize "${width}x${height}^" \
	-gravity center \
	-extent "${width}x${height}" \
	-filter Gaussian \
	-blur 0x8 \
	-fill '#1f232bcc' \
	-colorize 18% \
	"$tmp_file"

mv "$tmp_file" "$out_file"
