;; System-wide keyboard remapping for Fedora.
;;
;; Caps Lock behaves like Escape when tapped and Left Control when held. All
;; other keys pass through unchanged. `tap-hold-press` activates Control early
;; when Caps Lock is chorded with another key, which keeps shortcuts responsive.

(defcfg
  process-unmapped-keys yes
  ;; Only remap the physical keyboard. Let Sway/libinput handle the
  ;; ThinkPad hotkey and Intel HID devices so their XF86 mappings survive.
  linux-dev-names-include "AT Translated Set 2 keyboard"
)

(defsrc
  caps grv ralt 4 rmet
)

(defalias
  cap (tap-hold-press 200 200 esc lctl)
  dollar RA-4
  altgr (multi ralt (layer-while-held altgr))
)

(deflayer base
  @cap @dollar @altgr 4 XX
)

(deflayer altgr
  _ _ _ 5 _
)
