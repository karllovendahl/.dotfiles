#!/usr/bin/env bash

set -euo pipefail

# Waybar's network module is the status display. This script provides a
# chooser that opens on cached results while NetworkManager refreshes the list.

wifi_device="${NM_WIFI_DEVICE:-$(nmcli -t -f DEVICE,TYPE device status | awk -F: '$2 == "wifi" { print $1; exit }')}"

if [[ -z "$wifi_device" ]]; then
  notify-send "Wi-Fi" "No Wi-Fi device is available."
  exit 1
fi

# Fuzzel 1.14 renders dmenu input while stdin is still open. The producer
# prints cached networks first, then appends newly discovered SSIDs as the
# background scan completes.
choice="$(python3 - "$wifi_device" <<'PY' | fuzzel --dmenu --no-sort --mesg 'Scanning for Wi-Fi networks…' --prompt 'Wi-Fi  '
import subprocess
import sys
import time


def split_nmcli(line: str) -> list[str]:
    fields: list[str] = []
    field: list[str] = []
    escaped = False
    for char in line.rstrip("\n"):
        if escaped:
            field.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            fields.append("".join(field))
            field.clear()
        else:
            field.append(char)
    if escaped:
        field.append("\\")
    fields.append("".join(field))
    return fields


def networks(device: str) -> dict[str, tuple[int, str]]:
    result = subprocess.run(
        ["nmcli", "-t", "-f", "SSID,SECURITY,SIGNAL", "device", "wifi", "list", "ifname", device],
        check=True,
        capture_output=True,
        text=True,
    )
    best: dict[str, tuple[int, str]] = {}
    for line in result.stdout.splitlines():
        fields = split_nmcli(line)
        if len(fields) != 3:
            continue
        ssid, security, signal = fields
        if not ssid or ssid == "--":
            continue
        try:
            strength = int(signal)
        except ValueError:
            continue
        if ssid not in best or strength > best[ssid][0]:
            best[ssid] = (strength, security or "open")
    return best


def emit(current: dict[str, tuple[int, str]], emitted: set[str]) -> None:
    for ssid, (strength, security) in sorted(
        current.items(), key=lambda item: (-item[1][0], item[0].casefold())
    ):
        if ssid in emitted:
            continue
        print(f"{ssid}\t[{security}] {strength}%", flush=True)
        emitted.add(ssid)


device = sys.argv[1]
emitted: set[str] = set()
try:
    emit(networks(device), emitted)
    scan = subprocess.Popen(
        ["nmcli", "device", "wifi", "rescan", "ifname", device],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        time.sleep(0.25)
        emit(networks(device), emitted)
    scan.wait(timeout=1)
except (BrokenPipeError, subprocess.SubprocessError, OSError):
    # The user selected or cancelled the menu before the scan finished.
    pass
PY
)" || exit 0

ssid="${choice%%$'\t'*}"

terminal_script='nmcli --ask device wifi connect "$1" ifname "$2"; status=$?; echo; read -r -p "Press Enter to close..." _; exit "$status"'
exec wezterm start --always-new-process -- bash -lc "$terminal_script" -- "$ssid" "$wifi_device"
