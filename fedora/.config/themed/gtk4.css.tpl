/* Rendered by theme-render. Edit ~/.config/themed/gtk4.css.tpl instead. */
/* libadwaita colours (Files, Settings, Text Editor, ...), with the shared roles:
   background for content, surface for chrome, accent for focus and actions. */
:root {
  --window-bg-color: {{ background }};
  --window-fg-color: {{ foreground }};
  --view-bg-color: {{ background }};
  --view-fg-color: {{ foreground }};
  --headerbar-bg-color: {{ surface }};
  --headerbar-fg-color: {{ foreground }};
  --headerbar-backdrop-color: {{ background }};
  --sidebar-bg-color: {{ surface }};
  --sidebar-fg-color: {{ foreground }};
  --sidebar-backdrop-color: {{ surface }};
  --card-bg-color: {{ surface }};
  --card-fg-color: {{ foreground }};
  --dialog-bg-color: {{ surface }};
  --dialog-fg-color: {{ foreground }};
  --popover-bg-color: {{ overlay }};
  --popover-fg-color: {{ foreground }};
  --accent-color: {{ accent }};
  --accent-bg-color: {{ accent }};
  --accent-fg-color: {{ on_accent }};
}

