/* Rendered by theme-render. Edit ~/.config/themed/gtklock.css.tpl instead. */
/* Same roles as the bars: the accent marks the focused field; the unlock button
   is dark green. */
@define-color lock-background {{ background }};
@define-color lock-overlay {{ overlay }};
@define-color lock-foreground {{ foreground }};
@define-color lock-muted {{ muted }};
@define-color lock-accent {{ accent }};
@define-color lock-button {{ button_fill }};
@define-color lock-on-button {{ on_button_fill }};
@define-color lock-red {{ color1 }};
