{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,
  "reload_style_on_change": true,
  "modules-left": ["custom/mark-left", "clock", "custom/slash-left"],
  "modules-center": ["sway/workspaces"],
  "modules-right": ["tray", "custom/slash-right", "memory", "custom/divider", "cpu", "custom/divider", "custom/volume", "custom/divider", "network", "custom/divider", "battery"],

  "custom/mark-left": {
    "format": "[ thock ]"
  },
  "custom/slash-left": {
    "format": "/"
  },
  "custom/slash-right": {
    "format": "\\"
  },
  "custom/divider": {
    "format": "\\"
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S  %a %d %b}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"
  },
  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": true,
    "cursor": true,
    "format": "{name}"
  },
  "memory": {
    "interval": 5,
    "format": "MEM [{icon}] {percentage}%",
    "format-icons": ["░░░░░", "█░░░░", "██░░░", "███░░", "████░", "█████"],
    "tooltip-format": "{used:0.1f} GiB of {total:0.1f} GiB used"
  },
  "cpu": {
    "interval": 5,
    "format": "CPU [{icon}] {usage}%",
    "format-icons": ["░░░░░", "█░░░░", "██░░░", "███░░", "████░", "█████"]
  },
  "custom/volume": {
    "exec": "$HOME/.local/bin/waybar-volume",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "on-click": "pavucontrol",
    "on-click-right": "$HOME/.local/bin/sway-volume mute"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true
  },
  "network": {
    "interval": 5,
    "format-wifi": "NET [{icon}] {signalStrength}%",
    "format-ethernet": "NET [ETH]",
    "format-disconnected": "NET [OFF]",
    "format-icons": ["░░░░░", "█░░░░", "██░░░", "███░░", "████░", "█████"],
    "tooltip-format-wifi": "{essid}\n{ipaddr}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "No network connection",
    "on-click": "$HOME/.local/bin/wifi-menu",
    "on-click-right": "nm-connection-editor"
  },
  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "BAT [{icon}] {capacity}%",
    "format-charging": "CHG [{icon}] {capacity}%",
    "format-plugged": "CHG [{icon}] {capacity}%",
    "format-full": "CHG [{icon}] {capacity}%",
    "format-icons": ["░░░░░", "█░░░░", "██░░░", "███░░", "████░", "█████"]
  }
}
