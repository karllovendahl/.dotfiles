#!/usr/bin/env bash

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
readonly SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
readonly REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
readonly PALETTE_SOURCE="$REPO_ROOT/common/.config/palette/ink-paper.sh"
readonly TEMPLATE_DIR="$REPO_ROOT/common/.config/palette/templates"

mode="apply"
case "${1:-}" in
  ""|--apply) ;;
  --check) mode="check" ;;
  *)
    echo "Usage: palette-apply [--apply|--check]" >&2
    exit 2
    ;;
esac

# shellcheck source=/dev/null
source "$PALETTE_SOURCE"

for name in ${!PALETTE_@}; do
  value="${!name}"
  if [[ "$value" == \#* ]]; then
    printf -v "${name}_NO_HASH" '%s' "${value#\#}"
  fi
done

changed=0
render() {
  local template="$1" destination="$2" content name temporary
  content="$(<"$TEMPLATE_DIR/$template")"
  for name in ${!PALETTE_@}; do
    content="${content//\{\{$name\}\}/${!name}}"
  done

  temporary="$(mktemp)"
  printf '%s\n' "$content" >"$temporary"
  if [[ -f "$destination" ]] && cmp -s "$temporary" "$destination"; then
    rm -f "$temporary"
    return
  fi

  changed=1
  if [[ "$mode" == "check" ]]; then
    echo "Palette drift: ${destination#"$REPO_ROOT/"}" >&2
    rm -f "$temporary"
  else
    mkdir -p "$(dirname -- "$destination")"
    mv -f "$temporary" "$destination"
    echo "Rendered ${destination#"$REPO_ROOT/"}"
  fi
}

render "palette.lua" "$REPO_ROOT/common/.config/palette/generated/palette.lua"
render "palette.sh" "$REPO_ROOT/common/.config/palette/generated/palette.sh"
render "sway.conf" "$REPO_ROOT/common/.config/palette/generated/sway.conf"
render "tmux.conf" "$REPO_ROOT/common/.config/palette/generated/tmux.conf"
render "waybar-colors.css" "$REPO_ROOT/linux/.config/waybar/colors.css"
render "fuzzel.ini" "$REPO_ROOT/common/.config/palette/generated/fuzzel.ini"
render "dunstrc" "$REPO_ROOT/linux/.config/dunst/dunstrc"
render "gtklock.css" "$REPO_ROOT/common/.config/palette/generated/gtklock.css"
render "workspace-brackets.svg" "$REPO_ROOT/linux/.config/waybar/workspace-brackets.svg"

if [[ "$mode" == "check" && "$changed" -ne 0 ]]; then
  echo "Run palette-apply to regenerate palette consumers." >&2
  exit 1
fi
