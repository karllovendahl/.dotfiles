#!/bin/bash
# Omarchy runs this after every theme switch, with the theme name as $1.
# Omarchy owns the switch; this renders the dotfiles templates (WezTerm,
# Neovim, tmux, prompt) from the same colors.toml. Walker imports Omarchy's
# own walker.css directly.

set -euo pipefail

theme_dir="$HOME/.config/omarchy/current/theme"
name="${1:-$(cat "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || echo omarchy)}"

if [[ -f "$theme_dir/colors.toml" ]]; then
  "$HOME/.local/bin/theme-render" "$theme_dir/colors.toml" "$name"
  "$HOME/.local/bin/theme-reload"
fi
